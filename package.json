{
  "name": "@rxjs-ninja/rxjs-ninja",
  "description": "Monorepo tooling for RxJS Ninja operator libraries",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "libs/rxjs/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:e2e": "node scripts/build-e2e-bundles.mjs",
    "test": "vitest run",
    "example:goldberg": "vitest run examples/digital-rube-goldberg.spec.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:browser": "npm run build:e2e && playwright test",
    "test:all": "npm run test && npm run test:browser",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"libs/**/*.ts\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"libs/**/*.ts\" \"e2e/**/*.ts\"",
    "coverage": "codecov --disable=gcov --yml=codecov.yaml",
    "docs:prod": "typedoc --options typedoc.prod.json",
    "docs:dev": "typedoc --options typedoc.dev.json",
    "cleanup:branches": "git pull --prune && git branch -vv | grep ': gone]'|  grep -v \"\\*\" | awk '{ print $1; }' | xargs -r git branch -D"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@trust/webcrypto": "0.9.2",
    "@types/node": "25.9.1",
    "@types/w3c-web-serial": "1.0.8",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "@vitest/coverage-v8": "4.1.7",
    "codecov": "3.8.3",
    "dotenv": "17.4.2",
    "esbuild": "0.28.0",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eventsourcemock": "2.0.0",
    "globals": "16.2.0",
    "prettier": "3.8.3",
    "rxjs": "7.8.2",
    "rxjs-marbles": "7.0.1",
    "tslib": "2.8.1",
    "typedoc": "0.28.19",
    "typedoc-plugin-extras": "4.0.1",
    "typedoc-plugin-replace-text": "4.2.0",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "4.1.7",
    "web-streams-polyfill": "4.3.0"
  }
}
